{
  "name": "monero-web-wallet-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Local backend that proxies a Monero web wallet UI to monero-wallet-rpc",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsc -p tsconfig.json && cd dist && node --test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "typescript": "^7.0.2"
  }
}
